# =============================================================
# SNEWS.INFO — Environment template
# Copy this file to .env.local and fill in your free-tier keys.
# Never commit the real .env.local to git.
# =============================================================

# --- Supabase (free tier: https://supabase.com/dashboard) ---
# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret server-side key (Settings > API > service_role). NEVER expose in browser.
SUPABASE_SERVICE_ROLE_KEY=
# Internal URL for server-side connections (database access)
SUPABASE_DB_URL=

# --- Supabase Auth redirect ---
# Full URL of the deployed site (used by email verification links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Google Gemini (free tier: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Resend email (free tier: https://resend.com) ---
RESEND_API_KEY=
RESEND_FROM=SNEWS <no-reply@snews.info>

# --- Cloudflare Turnstile (free: https://dash.cloudflare.com → Turnstile) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Upstash Redis (free tier: https://upstash.com) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
